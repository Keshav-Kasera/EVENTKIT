# =========================================================
# EventKit Environment Configuration Template
# Copy to apps/api/.env and apps/web/.env (NEVER commit .env)
# =========================================================

# Cloud PostgreSQL (Neon.tech)
# Pooled runtime URL (with ?pgbouncer=true when using -pooler) & Direct URL for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT Signing Secret (generate a strong 32+ char random string)
JWT_SECRET="replace-with-strong-random-secret-key"
JWT_EXPIRES_IN="72h"

# QR Manifest HMAC Signing Secret
QR_HMAC_SECRET="replace-with-strong-qr-hmac-secret"

# Demo Mode & Seed Password (set only for academic/demo environments)
ENABLE_DEMO_MODE="true"
DEMO_SEED_PASSWORD="replace-with-demo-seed-password"

# API Server Config
PORT=4000
NODE_ENV="development"
CLIENT_ORIGIN="http://localhost:5173"

# Frontend API URL (apps/web/.env)
VITE_API_URL="http://localhost:4000/api"
VITE_WS_URL="http://localhost:4000"
